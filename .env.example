# Documentation of environment variable names; this file is not auto-loaded.
# Never put real credentials in this example.
APP_AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
APP_HOST=127.0.0.1
APP_PORT=8765
APP_ALLOWED_HOSTS=
ASR_MODEL_PATH=
# ASR_PYTHON and ASR_LANGUAGE may be set independently for speech recognition.
# ANTHROPIC_API_KEY is a process secret for direct server use; do not put it here.
# Start-Local.ps1 -Provider claude uses the account-bound DPAPI credential and
# fixes its child ledger to .runtime/mesa02/claude-ledger.jsonl, USD 0.50, 24 calls.
# The launcher does not use environment overrides for that ledger, cap or count.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Viewer gateway: configure only in the process environment; no dotenv auto-load.
# APP_PUBLIC_ORIGIN: exact HTTPS origin, no path or trailing slash.
# APP_GATEWAY_SECRET: shared random process secret; never put it in this file.
# APP_GATEWAY_PORT: loopback gateway listener (default 18876).
